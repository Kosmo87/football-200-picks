# Local Netlify folder
.netlify

# Analysis caches derived from ESPN's permanent record. Box scores and player
# statlines stay available for finished games indefinitely, so these are
# re-derivable in minutes and do not belong in git at ~19 MB per season.
# data/archive/ is the opposite case and IS committed: ESPN deletes betting
# lines once a game finals, so nothing can rebuild those.
/cache/players_*.json

# Free bulk line archives, re-downloadable from their public URLs at any time.
# cfb_line_odds expands to ~136 MB; nflverse games is small but equally derived.
/cache/cfb_line_odds.csv*
/cache/nflverse_games.csv

# Node, for the placements function only. The lockfile IS committed so CI
# installs the exact bundle that was tested.
node_modules/

# Written by netlify dev when it sets up the edge-functions runtime. Not ours.
deno.lock

# nflverse play-by-play, ~19 MB a season and re-downloadable from a public URL
# at any time. Same rule as the other derived caches: not committed.
/cache/pbp_*.csv.gz
